{
  "main_pass": [
    "-n", "-c:v", "ffv1",
    "-level", "3",
    "-coder", "1",
    "-context", "1",
    "-g", ["gop_size", "INT", {"default": 1, "min": 1, "max": 300, "step": 1}],
    "-slices", "16",
    "-slicecrc", "1",
    "-pix_fmt", ["pix_fmt", ["yuv420p", "yuv422p", "yuv444p", "yuva444p", "yuv420p10le", "yuv444p10le", "rgba64le"], {"default": "yuv420p"}]
  ],
  "audio_pass": ["-c:a", "flac"],
  "save_metadata": ["save_metadata", "BOOLEAN", {"default": true}],
  "trim_to_audio": ["trim_to_audio", "BOOLEAN", {"default": false}],
  "extension": "mkv"
}
